          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最佳兼容性 (AAC)"
          }
        }
      }
    },
    "download.quality.video.audio_preset.best_quality": {
      "comment": "The video audio preset that favors the highest available source quality.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Best Quality"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最高品質"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最高音质"
          }
        }
      }
    },
    "download.quality.video.audio_preset.help": {
      "comment": "Help text explaining the audio preset used for video downloads.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Best Compatible prefers AAC audio for broader playback support. Best Quality keeps the best available source audio without preferring a codec."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "互換性重視：再生互換性を高めるため、AAC音声を優先します。\n高音質重視：特定のコーデックを優先せず、利用可能な最高のソース音質をそのまま維持します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“最佳兼容性”优先使用 AAC 音频以获得更广的播放器支持。“最高音质”保留源文件中最佳音质而不偏好特定编码。"
          }
        }
      }
    },
    "download.quality.video.audio_preset.title": {
      "comment": "The label for choosing an audio preset for video downloads.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio Preset"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声プリセット"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频预设"
          }
        }
      }
    },
    "download.quality.video.codec_help": {
      "comment": "A description of the video codec compatibility options.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "H.264 and H.265/HEVC in MP4 are compatible with the Photos app. H.264 is preferred when both are available."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MP4形式のH.264およびH.265/HEVCは、「写真」アプリに対応しています。両方を利用可能な場合は、H.264が優先されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MP4 容器中的 H.264 和 H.265/HEVC 编码可直接保存到 iOS“照片”。两者均可用时优先使用 H.264。"
          }
        }
      }
    },
