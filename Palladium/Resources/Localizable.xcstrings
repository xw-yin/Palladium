    "download.quality.audio.best_help": {
      "comment": "A description of the best audio format and quality options.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Format and bitrate choices apply when using the Audio preset."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声プリセットを使用する場合、フォーマットとビットレートの選択が適用されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "格式与比特率设置在选择“音频”预设时生效。"
          }
        }
      }
