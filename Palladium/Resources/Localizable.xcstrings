    "settings.storage.cache.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cache stores yt-dlp metadata and web assets. Clearing it may make the next run a little slower."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュには、yt-dlpメタデータとWebアセットが保存されます。クリアすると、次の実行が少し遅くなる可能性があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缓存用于存储 yt-dlp 元数据与网页资源。清理缓存可能会使下次解析稍微变慢。"
          }
        }
      }
    },
    "settings.storage.cache.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "yt-dlp Cache"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "yt-dlp キャッシュ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "yt-dlp 缓存"
          }
        }
      }
    },
    "settings.storage.disabled_help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Storage actions are disabled while a download or package task is running."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードまたはパッケージタスクの実行中にストレージアクションが無効になります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在运行下载或包管理任务时无法执行存储操作。"
          }
        }
      }
    },
    "settings.storage.downloads.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This only affects Palladium's temporary download folder. Use it to remove stale run folders without touching Saved Files."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはPalladiumの一時的なダウンロードフォルダにのみ影響します。保存されたファイルに触れずに古い実行フォルダを削除するために使用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅影响 Palladium 临时下载文件夹。用于清理残留的运行文件夹，不会影响“已保存”的文件。"
          }
        }
      }
    },
    "settings.storage.downloads.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporary Downloads"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時ダウンロード"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "临时下载"
          }
        }
      }
    },
    "settings.storage.overview.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporary Downloads stores active and recent run folders. Saved Files keeps copies made with Save to App Folder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「一時ダウンロード」には、実行中および最近完了したダウンロードのフォルダが保存されます。「保存されたファイル」には、「アプリフォルダへ保存」機能で保存したファイルのコピーが保存されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“临时下载”存放正在进行及最近的运行目录。“已保存文件”保留通过“保存到应用文件夹”保存的副本。"
          }
        }
      }
    },
    "settings.storage.overview.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overview"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "概要"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "概览"
          }
        }
      }
    },
    "settings.storage.refresh": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
