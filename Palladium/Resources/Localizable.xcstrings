    "cookies.paste.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste Netscape cookie text below. Palladium will normalize it before saving."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以下にNetscape形式のクッキーテキストを貼り付けてください。Palladiumが保存する前に正規化します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在下方粘贴 Netscape 格式的 Cookie 文本。Palladium 会在保存前进行格式规范化。"
