    "settings.saved_downloads.always_folder": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always create a folder"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常にフォルダを作成"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "总是创建文件夹"
          }
        }
      }
    },
    "settings.saved_downloads.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Service folders add a parent based on the source service. Subdomains and known short-link domains share one folder. Collections still use their own folder; single downloads use one only when Always create a folder is enabled."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サービスフォルダは、ソースサービスに基づいて親を追加します。サブドメインと既知のショートカットドメインは、1 つのフォルダを共有します。 コレクションはまだ独自のフォルダを使用します。単一のダウンロードは、常にフォルダを作成が有効になっている場合にのみ使用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务文件夹会根据来源网站建立父目录。子域名和已知短链接平台共享同一文件夹。合集下载始终使用独立文件夹；单个下载仅在开启“总是创建文件夹”时生效。"
          }
        }
      }
    },
    "settings.saved_downloads.organize_by_service": {
