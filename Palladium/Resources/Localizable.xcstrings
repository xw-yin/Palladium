    "settings.website_args.empty": {
      "comment": "Shown when no per-website argument rules exist.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No website rules yet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだウェブサイトのルールはありません。"
          }
        }
      }
    },
    "settings.website_args.add": {
      "comment": "Button that adds a per-website argument rule.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Rule"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルールを追加"
          }
        }
      }
    },
    "settings.website_args.priority.footer": {
      "comment": "Explains how per-website argument rules are matched and prioritized.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only one rule applies to each link. Regex rules are checked first, from top to bottom. Otherwise the most specific website wins, so test.example.com is used before example.com. Website args are added after global extra args."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各リンクに適用されるルールは1つのみです。正規表現ルールが上から順に優先してチェックされます。それ以外の場合は、より具体的なウェブサイトが優先されるため、example.com よりも test.example.com が先に適用されます。ウェブサイト固有の引数は、グローバルな追加引数の後ろに追加されます。"
          }
        }
      }
    },
    "settings.website_args.test.section": {
      "comment": "Section header for checking which website rule applies to a link.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
