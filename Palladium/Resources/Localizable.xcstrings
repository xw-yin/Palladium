    "download.quality.override_format_list_export.help": {
      "comment": "Help text explaining the format-list export override setting.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply the video and audio Quality Settings when exporting a format selected from the format list."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーマットリストから選択したフォーマットをエクスポートする際に、動画と音声の品質設定を適用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从格式列表中选择格式并导出时，依然应用视频与音频质量设置。"
          }
        }
      }
    },
    "download.quality.override_format_list_export.title": {
      "comment": "A toggle that applies Quality Settings to format-list exports.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Override format-list export"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーマットリストのエクスポートを上書きする"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "覆盖格式列表导出"
          }
        }
      }
    },
    "download.quality.queued.help": {
      "comment": "Explains how quality selection behaves for queued downloads.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick max quality applies one choice to every pending download and asks again if a link lacks it. Choose for every link asks for each link before it downloads."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「最高画質を選択」を適用：保留中のすべてのダウンロードに同じ設定を一括適用し、最高画質が存在しないリンクについては改めて確認します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“选择最高画质”会将该选择应用于每个待下载项（若无此清晰度则再次询问）。“为每条链接选择”会在下载每项前分别弹出选择。"
          }
        }
      }
    },
    "download.quality.queued.mode.per_link": {
      "comment": "Queued quality mode that asks for a quality pick before each link.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose for every link"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクごとに選択"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为每条链接单独选择"
          }
        }
      }
    },
    "download.quality.queued.mode.pick_max": {
      "comment": "Queued quality mode that applies one chosen quality to the whole batch.",
