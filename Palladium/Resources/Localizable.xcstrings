    "cookies.empty.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import or paste Netscape cookies to make them available in downloads."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Netscape Cookie をインポートまたは貼り付けて、ダウンロードで利用できるようにします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入或粘贴 Netscape 格式的 Cookie，以便在下载时使用。"
          }
        }
      }
    },
    "cookies.empty.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No cookie files"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cookie ファイルがありません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无 Cookie 文件"
          }
        }
      }
    },
    "cookies.error.invalid_format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected cookie content does not look like Netscape cookies format."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択されたクッキーの内容が、Netscapeクッキーの形式ではないようです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选 Cookie 内容不符合 Netscape 格式规范。"
          }
        }
      }
    },
    "cookies.error.invalid_url": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a valid HTTP or HTTPS website URL."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なHTTPまたはHTTPSのウェブサイトのURLを入力してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入有效的 HTTP 或 HTTPS 网站网址。"
          }
        }
      }
    },
    "cookies.error.name_conflict": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not create a unique filename for the imported cookie file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インポートされたcookieファイルの一意のファイル名を作成できませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法为导入的 Cookie 文件生成唯一文件名。"
          }
        }
      }
    },
    "cookies.error.unreadable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected file could not be read as text."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したファイルをテキストとして読み込むことができませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法将所选文件作为文本读取。"
          }
        }
      }
    },
    "cookies.error.web_no_cookies": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No cookies were found. Sign in or continue browsing before importing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cookie が見つかりませんでした。インポートする前にサインインまたはブラウジングを続行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到任何 Cookie。导入前请登录或继续浏览该网站。"
          }
        }
      }
    },
