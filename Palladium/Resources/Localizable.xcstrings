    "settings.post_processing.remux": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remux"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマックス（再多重化）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新封装 (Remux)"
          }
        }
      }
    },
    "settings.post_processing.remux_help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remuxing changes the container without re-encoding, so it is faster and preserves quality. It can fail if the selected container does not support the original codecs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再多重化は、再エンコードせずに容器を変更するので、より速く、品質を維持します。 選択したコンテナが元のコーデックをサポートしていない場合、失敗する可能性があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新封装无需重新编码即可改变容器格式，速度极快且完全保留原画质。如果目标容器不支持原始编码格式，则可能会失败。"
          }
        }
      }
    },
    "settings.post_processing.scope": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to video downloads, including format selections. Audio-only and image downloads are unchanged. Enabled conversion overrides video container and conversion arguments. Queued downloads keep the settings chosen when added."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーマット選択を含む動画ダウンロードに適用されます。音声のみと画像のダウンロードは変更されません。 変換を有効にすると、動画コンテナと変換引数が上書きされます。キューに追加されたダウンロードは、追加時に選択された設定を維持します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于视频下载（包括从格式列表中选择的格式）。纯音频和画廊图片下载不受影响。启用转换后将覆盖原视频容器和转换参数。队列下载将保留添加时选择的配置。"
          }
        }
      }
    },
    "settings.post_processing.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-encode or remux downloaded videos into another format"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画を別のフォーマットにエンコードまたは再多重化する"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将下载的视频重新编码或重新封装为其他格式"
          }
        }
      }
    },
    "settings.post_processing.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Post Processing"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポスト処理中"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后期处理 (Post Processing)"
          }
        }
      }
    },
    "settings.post_processing.warning": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default. Re-encoding increases CPU usage, battery use, and processing time, and may reduce quality. Videos already in the chosen format are not re-encoded."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトではオフです。再エンコードするとCPUの使用率、バッテリー使用率、処理時間が増加し、品質が低下する可能性があります。選択したフォーマットの動画は再エンコードされません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭。重新编码会消耗更多 CPU 和电池电量、增加处理时间，并可能略微降低画质。已经是目标格式的视频不会重复编码。"
          }
        }
      }
    },
    "settings.about.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version and quick help"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョンとヘルプ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "版本信息与快捷帮助"
          }
        }
