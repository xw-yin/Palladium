    "download.quality.video.audio_preset.best_compatible": {
      "comment": "The video audio preset that favors broad playback compatibility.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Best Compatible"
          }
        },
        "ja": {
          "stringUnit": {
